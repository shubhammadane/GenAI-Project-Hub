# LLM API Keys (Set at least one, or use mock mode for offline testing)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default LLM Provider: "gemini", "openai", "anthropic", or "mock"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# DuckDB & Execution Limits
MAX_UPLOAD_SIZE_MB=50
QUERY_TIMEOUT_SECONDS=10
DEFAULT_ROW_LIMIT=500
MAX_ROW_LIMIT=10000

# Security & CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=60

# Database Connectors (Optional)
DATABASE_READONLY_URL=
