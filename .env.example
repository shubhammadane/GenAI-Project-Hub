# EasyResearch — Root .env.example
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# ---- Node.js / Express Backend ----
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/easyresearch
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=7d

# ---- Python FastAPI AI Service ----
AI_SERVICE_PORT=8000

# ---- LLM Provider (choose one) ----
LLM_PROVIDER=gemini             # gemini | openai | groq
GOOGLE_API_KEY=                 # Gemini API key
GEMINI_MODEL=gemini-3.8-flash   # Override when a model is unavailable for your API project
OPENAI_API_KEY=                 # OpenAI API key (if using OpenAI)
GROQ_API_KEY=                   # Groq API key (if using Groq)

# ---- Vector Database ----
VECTOR_DB=chroma                # chroma | faiss | qdrant
CHROMA_HOST=localhost
CHROMA_PORT=8002
QDRANT_URL=http://localhost:6333

# ---- File Storage ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ---- CORS ----
FRONTEND_URL=http://localhost:5173
